{
  "name": "@ironlox/extension",
  "version": "0.1.0",
  "type": "module",
  "description": "Ironlox browser extension (Plasmo — Chrome + Firefox)",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "browser-extension",
    "plasmo",
    "autofill"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "test": "echo 'No tests yet'",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build .plasmo"
  },
  "dependencies": {
    "@ironlox/api-client": "workspace:*",
    "@ironlox/autofill": "workspace:*",
    "@ironlox/crypto": "workspace:*",
    "@ironlox/schemas": "workspace:*",
    "fuse.js": "^7.0.0",
    "plasmo": "^0.90.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.0"
  },
  "manifest": {
    "name": "Ironlox",
    "version": "0.1.0",
    "description": "Zero-knowledge password manager. TOTP 2FA, autofill, breach monitoring, and vault health reports - all client-side encrypted.",
    "permissions": [
      "storage",
      "activeTab",
      "clipboardWrite",
      "alarms",
      "idle",
      "contextMenus"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Ctrl+Shift+L",
          "mac": "Command+Shift+L"
        }
      },
      "copy-password": {
        "description": "Copy password of first matching login",
        "suggested_key": {
          "default": "Ctrl+Shift+C",
          "mac": "Command+Shift+C"
        }
      },
      "copy-username": {
        "description": "Copy username of first matching login",
        "suggested_key": {
          "default": "Ctrl+Shift+U",
          "mac": "Command+Shift+U"
        }
      },
      "lock-vault": {
        "description": "Lock the vault",
        "suggested_key": {
          "default": "Ctrl+Shift+K",
          "mac": "Command+Shift+K"
        }
      }
    }
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "@parcel/transformer-inline-string": "^2.9.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.33.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
