{
  "name": "@ironlox/extension",
  "version": "0.1.0",
  "type": "module",
  "description": "Ironlox browser extension (Plasmo — Chrome + Firefox)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironlox/ironlox.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/ironlox/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "browser-extension",
    "plasmo",
    "autofill"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "test": "echo 'No tests yet'",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build .plasmo"
  },
  "dependencies": {
    "@ironlox/api-client": "workspace:*",
    "@ironlox/autofill": "workspace:*",
    "@ironlox/crypto": "workspace:*",
    "@ironlox/schemas": "workspace:*",
    "fuse.js": "^7.0.0",
    "plasmo": "^0.90.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
