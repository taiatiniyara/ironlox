---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const href = Astro.props.href ?? "https://app.ironlox.com";
const variant = Astro.props.variant ?? "primary";
const size = Astro.props.size ?? "md";

const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-8 py-4",
  lg: "px-10 py-4",
};

const variantClasses = {
  primary:
    "bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl transition-all shadow-lg shadow-brand-500/25",
  secondary:
    "border border-white/10 hover:border-white/20 text-white font-semibold rounded-xl transition-all",
  outline:
    "block text-center w-full py-3 rounded-xl border border-white/10 text-white font-medium hover:bg-white/3 transition-colors text-sm",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center gap-2",
    sizeClasses[size],
    variantClasses[variant],
    Astro.props.class,
  ]}
>
  <slot />
</a>
