---
export interface Props {
  title: string;
  canonicalURL: string;
  lastUpdated?: string;
}

const { title, canonicalURL, lastUpdated = "2025" } = Astro.props;

const baseUrl = "https://ironlox.com";

const breadcrumbLabel = title.replace(/ — Ironlox$/, "");

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${baseUrl}/` },
    { "@type": "ListItem", position: 2, name: breadcrumbLabel, item: canonicalURL },
  ],
};

import Layout from "../layouts/Layout.astro";
import NavBar from "./NavBar.astro";
---

<Layout title={title} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <NavBar variant="legal" />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold text-white mb-3">{breadcrumbLabel}</h1>
    <p class="text-sm text-surface-700 mb-10">Last updated: {lastUpdated}</p>
    <slot />
  </main>
</Layout>
