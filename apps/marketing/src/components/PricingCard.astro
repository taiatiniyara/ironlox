---
export interface Props {
  tier: "Free" | "Premium";
  price: string;
  annualPrice?: string;
  billingNote: string;
  annualBillingNote?: string;
  ctaText: string;
  ctaVariant?: "primary" | "outline";
  highlighted?: boolean;
  delay?: number;
}

const {
  tier,
  price,
  annualPrice,
  billingNote,
  annualBillingNote,
  ctaText,
  ctaVariant = "primary",
  highlighted = false,
  delay = 1,
} = Astro.props;

import CheckIcon from "./icons/CheckIcon.astro";
---

<div
  class:list={[
    "rounded-2xl p-8 flex flex-col relative card-glow reveal",
    `reveal-delay-${delay}`,
    {
      "border border-white/6 bg-surface-850/50": !highlighted,
      "border border-brand-500/30 bg-linear-to-b from-brand-500/5 to-transparent animate-pulse-glow": highlighted,
    },
  ]}
>
  {
    highlighted && (
      <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-brand-500 text-white text-xs font-semibold px-4 py-1.5 rounded-full whitespace-nowrap">
        Most popular
      </div>
    )
  }
  <h3 class="text-xl font-semibold text-white mb-1">{tier}</h3>
  <p class="text-sm text-surface-200 mb-5">{tier === "Free" ? "Perfect for getting started." : "For security-minded individuals."}</p>
  <p class="text-4xl font-extrabold text-white mb-1">
    <span class="price-monthly">{price}</span>
    {annualPrice && <span class="price-annual hidden">{annualPrice}</span>}
    <span class="text-lg text-surface-200 font-normal">/mo</span>
  </p>
  <p class="text-xs text-surface-700 mb-8">
    <span class="price-monthly">{billingNote}</span>
    {annualBillingNote && <span class="price-annual hidden">{annualBillingNote}</span>}
  </p>
  <ul class="space-y-3 mb-8 flex-1">
    <slot />
  </ul>
  <a
    href="https://app.ironlox.com"
    class:list={[
      "block text-center w-full py-3 rounded-xl font-semibold transition-colors text-sm",
      {
        "bg-brand-500 hover:bg-brand-600 text-white": ctaVariant === "primary",
        "border border-white/10 text-white hover:bg-white/3": ctaVariant === "outline",
      },
    ]}
  >
    {ctaText}
  </a>
</div>
