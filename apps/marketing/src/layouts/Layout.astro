---
export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
}

const baseUrl = "https://ironlox.com";
const title = Astro.props.title || "Ironlox \u2014 Zero-Knowledge Encrypted Vault";
const description =
  Astro.props.description ||
  "Ironlox encrypts your passwords, credit cards, notes, identities, and files on your device. We never see them. Open source. Privacy first. Try it free.";
const canonical = Astro.props.canonicalURL || Astro.url.href;

import "../styles/global.css";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Ironlox",
  url: baseUrl,
  logo: `${baseUrl}/logo.svg`,
  description: description,
  foundingDate: "2025",
  founder: {
    "@type": "Organization",
    name: "Taia Tiniyara, LLC",
  },
  sameAs: ["https://github.com/taiatiniyara/ironlox"],
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ironlox",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Web, Chrome, Firefox, iOS, Android",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description: description,
  url: baseUrl,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${baseUrl}/logo.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:site_name" content="Ironlox" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/logo.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)}></script>

    <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
    <link rel="apple-touch-icon" href="/logo-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:bg-brand-500 focus:text-white focus:rounded-lg focus:outline-none">
      Skip to content
    </a>
    <slot />
  </body>
</html>
