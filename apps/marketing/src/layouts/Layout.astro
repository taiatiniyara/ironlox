---
export interface Props {
  title?: string;
}

const { title = "Ironlox — Zero-Knowledge Password Manager" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Zero-knowledge password manager. Your passwords, encrypted on your device. We never see them." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Zero-knowledge password manager. Open source. Privacy first." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />

    <style is:global>
      :root {
        --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: #0a0a0f;
        color: #e5e5e5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
