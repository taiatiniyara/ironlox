---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
---

<Layout>
  <NavBar />
  <main id="main-content" class="min-h-screen pt-24 pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold text-white mb-2">Documentation</h1>
      <p class="text-surface-200 mb-10 text-sm leading-relaxed">
        Comprehensive guides for setting up and using Ironlox. Full knowledge base coming soon.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-10">
        <a href="https://github.com/taiatiniyara/ironlox#readme" class="rounded-xl border border-white/6 bg-surface-850/50 p-5 hover:border-brand-500/30 transition-colors">
          <h3 class="text-sm font-semibold text-white mb-2">README</h3>
          <p class="text-xs text-surface-200">Setup instructions, architecture overview, and development guide.</p>
        </a>
        <a href="/security" class="rounded-xl border border-white/6 bg-surface-850/50 p-5 hover:border-brand-500/30 transition-colors">
          <h3 class="text-sm font-semibold text-white mb-2">Security Policy</h3>
          <p class="text-xs text-surface-200">Encryption standards, vulnerability disclosure, and infrastructure security.</p>
        </a>
        <a href="/privacy" class="rounded-xl border border-white/6 bg-surface-850/50 p-5 hover:border-brand-500/30 transition-colors">
          <h3 class="text-sm font-semibold text-white mb-2">Privacy Policy</h3>
          <p class="text-xs text-surface-200">What we store, what we never see, and how we handle your data.</p>
        </a>
        <a href="/migration-guides" class="rounded-xl border border-white/6 bg-surface-850/50 p-5 hover:border-brand-500/30 transition-colors">
          <h3 class="text-sm font-semibold text-white mb-2">Migration Guides</h3>
          <p class="text-xs text-surface-200">Switch from 1Password, Bitwarden, LastPass, or Chrome Password Manager.</p>
        </a>
      </div>
      <div class="rounded-2xl border border-white/6 bg-surface-850/50 p-10 text-center">
        <svg class="w-12 h-12 text-surface-700 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <h2 class="text-lg font-semibold text-white mb-2">Full knowledge base coming soon</h2>
        <p class="text-sm text-surface-200">
          We're building a searchable docs site with setup wizards, troubleshooting guides, and API reference.
          For now, the GitHub README covers development and architecture.
        </p>
      </div>
    </div>
  </main>
</Layout>
