---
import Layout from "../layouts/Layout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What happens if I forget my master password?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Your master password is the only key to your vault. We cannot reset it and cannot recover your data without it. Write it down. Store it somewhere safe. Export your vault regularly as a backup.",
      },
    },
    {
      "@type": "Question",
      name: "Can Ironlox see any of my data?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Your vault is encrypted on your device with your master password. We receive only an encrypted blob. Even with full database access, your data is mathematically unreadable without your password.",
      },
    },
    {
      "@type": "Question",
      name: "Is Ironlox really open source?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every line of code — the client apps, the encryption library, the server — is public on GitHub. You can read it, audit it, and build it yourself. Trust through transparency.",
      },
    },
    {
      "@type": "Question",
      name: "How do I switch from another password manager?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Export your data from your current manager as CSV, then import into Ironlox. We support formats from 1Password, Bitwarden, LastPass, Dashlane, and others. The import takes under a minute.",
      },
    },
    {
      "@type": "Question",
      name: "Does Ironlox work offline?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Your vault is cached locally on each device. You can access, edit, and use your passwords offline. Changes sync automatically when you reconnect.",
      },
    },
    {
      "@type": "Question",
      name: "How do you make money if the free tier is so generous?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We charge for Premium features ($3/mo). We never sell your data, show ads, or track you. Our business model is simple: you pay for extra features, and we keep your data private. Always.",
      },
    },
  ],
};
---

<Layout>
  <!-- Nav -->
  <header class="fixed top-0 inset-x-0 z-50 border-b border-white/4 bg-surface-950/80 backdrop-blur-xl">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center shrink-0" aria-label="Ironlox home">
        <img src="/logo.svg" alt="Ironlox" class="h-8 w-auto" />
      </a>

      <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" />
      <label for="mobile-menu-toggle" class="md:hidden p-2 -mr-2 cursor-pointer text-surface-200 hover:text-white peer-checked:hidden" aria-label="Open menu">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
      <label for="mobile-menu-toggle" class="md:hidden p-2 -mr-2 cursor-pointer text-surface-200 hover:text-white hidden peer-checked:inline-block" aria-label="Close menu">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </label>

      <div class="hidden peer-checked:flex md:flex flex-col md:flex-row absolute md:static top-16 left-0 right-0 bg-surface-950/95 md:bg-transparent backdrop-blur-xl md:backdrop-blur-none border-b md:border-0 border-white/4 p-6 md:p-0 gap-4 md:gap-6 items-start md:items-center text-sm">
        <a href="#features" class="text-surface-200 hover:text-white transition-colors">Features</a>
        <a href="#how-it-works" class="text-surface-200 hover:text-white transition-colors">How it works</a>
        <a href="#comparison" class="text-surface-200 hover:text-white transition-colors">Compare</a>
        <a href="#pricing" class="text-surface-200 hover:text-white transition-colors">Pricing</a>
        <a href="https://github.com/taiatiniyara/ironlox" class="text-surface-200 hover:text-white transition-colors">Docs</a>
        <a href="https://app.ironlox.com" class="inline-flex items-center px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-medium rounded-lg transition-colors">
          Sign up free
        </a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <section class="relative pt-32 pb-24 px-6 overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-225 h-225 bg-brand-500/8 rounded-full blur-3xl animate-float-slow" />
        <div class="absolute top-0 right-0 w-150 h-150 bg-brand-700/8 rounded-full blur-3xl animate-float" />
        <div class="absolute bottom-0 left-0 w-100 h-100 bg-brand-400/5 rounded-full blur-3xl animate-float-slow" />
      </div>
      <div class="max-w-5xl mx-auto text-center hero-stagger" id="hero-content">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-500/20 bg-brand-500/5 text-brand-300 text-sm mb-8">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          Open source and always will be
        </div>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.05] mb-6">
          Your digital life,<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-brand-400 via-brand-500 to-brand-600">locked tight.</span>
        </h1>
        <p class="text-lg text-surface-200 max-w-2xl mx-auto mb-10 leading-relaxed">
          Passwords, credit cards, identities, secure notes, TOTP codes, files &mdash;
          Ironlox encrypts it all on your device before anything leaves. We never see
          your data. Not now. Not ever.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a href="https://app.ironlox.com" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl transition-all shadow-lg shadow-brand-500/25">
            Sign up free &mdash; no credit card
          </a>
          <div class="flex flex-col items-center gap-1">
            <a href="https://github.com/taiatiniyara/ironlox" class="inline-flex items-center gap-2 px-8 py-4 border border-white/10 hover:border-white/20 text-white font-semibold rounded-xl transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              Star on GitHub
            </a>
            <img src="https://img.shields.io/github/stars/taiatiniyara/ironlox?style=social" alt="GitHub stars" class="h-5" loading="lazy" />
          </div>
        </div>
        <p class="text-xs text-surface-700">iOS &amp; Android apps coming soon &middot; 30-day risk-free trial &middot; Cancel anytime</p>
      </div>

      <!-- Product mockup -->
      <div class="max-w-3xl mx-auto mt-16 reveal">
        <div class="relative rounded-2xl border border-white/6 bg-surface-850/80 overflow-hidden shadow-2xl shadow-black/40">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/4 bg-surface-900/50">
            <div class="w-3 h-3 rounded-full bg-red-500/70" />
            <div class="w-3 h-3 rounded-full bg-yellow-500/70" />
            <div class="w-3 h-3 rounded-full bg-green-500/70" />
            <span class="ml-3 text-xs text-surface-700">Ironlox Vault</span>
          </div>
          <div class="p-6 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-white/4">
              <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">github.com</div>
                <div class="text-xs text-surface-700">john.dev@email.com</div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-[10px] font-medium">Autofill ready</span>
            </div>
            <div class="flex items-center gap-3 pb-3 border-b border-white/4">
              <div class="w-8 h-8 rounded-lg bg-surface-700/30 flex items-center justify-center">
                <svg class="w-4 h-4 text-surface-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">stripe.com</div>
                <div class="text-xs text-surface-700">admin@company.com</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">Visa &bull;&bull;&bull;&bull; 4242</div>
                <div class="text-xs text-surface-700">Expires 12/26</div>
              </div>
            </div>
          </div>
          <div class="px-6 py-3 bg-surface-900/80 border-t border-white/4 flex items-center justify-between">
            <span class="text-[11px] text-surface-700">12 items in vault</span>
            <div class="flex gap-2">
              <div class="w-16 h-1.5 rounded-full bg-surface-700/50"><div class="w-3/4 h-full rounded-full bg-red-500/50" /></div>
              <span class="text-[10px] text-surface-700">Health: Fair</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar -->
    <section class="border-y border-white/4 bg-surface-850/50">
      <div class="max-w-5xl mx-auto px-6 py-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          <div class="flex items-center gap-3 reveal reveal-delay-1">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span class="text-xs text-surface-200 font-medium">AES-256-GCM</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-2">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span class="text-xs text-surface-200 font-medium">Argon2id</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-3">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span class="text-xs text-surface-200 font-medium">Open Source</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-4">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
            <span class="text-xs text-surface-200 font-medium">Zero-Knowledge</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-5">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="text-xs text-surface-200 font-medium">No Trackers</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 reveal">One vault for your entire digital life</h2>
        <p class="text-surface-200 max-w-xl mx-auto reveal reveal-delay-1">Passwords, payments, notes, identities, files, and 2FA codes. All encrypted. All in one place.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-1">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">End-to-End Encrypted</h3>
            <p class="text-sm text-surface-200 leading-relaxed">AES-256-GCM encryption locks your vault on your device. Your master password never leaves your browser. We couldn&rsquo;t read your data if we wanted to.</p>
          </div>
          <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-2">
          <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">One-Click Autofill</h3>
            <p class="text-sm text-surface-200 leading-relaxed">Instantly fill usernames, passwords, credit cards, and TOTP codes on any site. Works on Chrome and Firefox. Saves you hundreds of keystrokes every day.</p>
          </div>
          <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-3">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Smart Generator</h3>
            <p class="text-sm text-surface-200 leading-relaxed">Create strong, unique passwords and passphrases with customizable rules. Length, symbols, numbers &mdash; generated locally on your device. Never reused. Never weak.</p>
          </div>
          <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-4">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Cross-Device Sync</h3>
            <p class="text-sm text-surface-200 leading-relaxed">Your vault syncs seamlessly across all your devices. Add a login on your desktop, it appears instantly on your phone. Your cards, notes, and files are always with you. Always encrypted.</p>
          </div>
          <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-5">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Vault Health Reports</h3>
            <p class="text-sm text-surface-200 leading-relaxed">Scan your vault for weak, reused, and breached passwords. Get actionable recommendations. Premium feature with automatic breach monitoring.</p>
          </div>
          <div class="group relative rounded-2xl border border-white/6 bg-surface-850/50 p-8 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300 card-glow reveal reveal-delay-6">
            <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">More Than Passwords</h3>
            <p class="text-sm text-surface-200 leading-relaxed">Store credit cards, secure notes, identities, file attachments, and TOTP codes. One vault for all your sensitive digital life.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-24 px-6 bg-surface-900/50">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How it works</h2>
          <p class="text-surface-200">Three simple steps. Zero compromises on privacy.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center relative reveal reveal-delay-1">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">1</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Create your vault</h3>
            <p class="text-sm text-surface-200">Sign up with your email and create a master password. Your encryption keys are derived and stored only on your device.</p>
          </div>
          <div class="text-center relative reveal reveal-delay-2">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">2</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Fill your vault</h3>
            <p class="text-sm text-surface-200">Save logins, credit cards, secure notes, and identities. Import from another manager or capture them as you browse. Everything is encrypted before syncing.</p>
          </div>
          <div class="text-center relative reveal reveal-delay-3">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">3</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Browse with peace</h3>
            <p class="text-sm text-surface-200">Autofill logs you in with one click. Your vault syncs across all your devices. You never type another password again.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Social proof -->
    <section class="py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14 reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Built for people who care about privacy</h2>
          <p class="text-surface-200">Join thousands of developers, security engineers, and privacy-conscious individuals.</p>
