---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureCard from "../components/FeatureCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import FaqItem from "../components/FaqItem.astro";
import RoadmapItem from "../components/RoadmapItem.astro";
import CtaButton from "../components/CtaButton.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import ChevronDown from "../components/icons/ChevronDown.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import ArrowRight from "../components/icons/ArrowRight.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import LockIcon from "../components/icons/LockIcon.astro";
import EyeOffIcon from "../components/icons/EyeOffIcon.astro";
import CrossIcon from "../components/icons/CrossIcon.astro";
import InfoIcon from "../components/icons/InfoIcon.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What happens if I forget my master password?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Your master password is the only key to your vault. We cannot reset it and cannot recover your data without it. Write it down. Store it somewhere safe. Export your vault regularly as a backup.",
      },
    },
    {
      "@type": "Question",
      name: "Can Ironlox see any of my data?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Your vault is encrypted on your device with your master password. We receive only an encrypted blob. Even with full database access, your data is mathematically unreadable without your password.",
      },
    },
    {
      "@type": "Question",
      name: "Is Ironlox really open source?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every line of code — the client apps, the encryption library, the server — is public on GitHub. You can read it, audit it, and build it yourself. Trust through transparency.",
      },
    },
    {
      "@type": "Question",
      name: "How do I switch from another password manager?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Export your data from your current manager as CSV, then import into Ironlox. We support formats from 1Password, Bitwarden, LastPass, Dashlane, and others. The import takes under a minute.",
      },
    },
    {
      "@type": "Question",
      name: "Does Ironlox work offline?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Your vault is cached locally on each device. You can access, edit, and use your passwords offline. Changes sync automatically when you reconnect.",
      },
    },
    {
      "@type": "Question",
      name: "How do you make money if the free tier is so generous?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We charge for Premium features ($3/mo). We never sell your data, show ads, or track you. Our business model is simple: you pay for extra features, and we keep your data private. Always.",
      },
    },
  ],
};
---

<Layout>
  <NavBar />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative pt-32 pb-24 px-6 overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-225 h-225 bg-brand-500/8 rounded-full blur-3xl animate-float-slow" />
        <div class="absolute top-0 right-0 w-150 h-150 bg-brand-700/8 rounded-full blur-3xl animate-float" />
        <div class="absolute bottom-0 left-0 w-100 h-100 bg-brand-400/5 rounded-full blur-3xl animate-float-slow" />
      </div>
      <div class="max-w-5xl mx-auto text-center hero-stagger" id="hero-content">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-500/20 bg-brand-500/5 text-brand-300 text-sm mb-8">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          Open source and always will be
        </div>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.05] mb-6">
          Your digital life,<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-brand-400 via-brand-500 to-brand-600">locked tight.</span>
        </h1>
        <p class="text-lg text-surface-200 max-w-2xl mx-auto mb-10 leading-relaxed">
          Passwords, credit cards, identities, secure notes, TOTP codes, files &mdash;
          Ironlox encrypts it all on your device before anything leaves. We never see
          your data. Not now. Not ever.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <CtaButton>Sign up free &mdash; no credit card</CtaButton>
          <div class="flex flex-col items-center gap-1">
            <CtaButton href="https://github.com/taiatiniyara/ironlox" variant="secondary">
              <GitHubIcon /> Star on GitHub
            </CtaButton>
            <img src="https://img.shields.io/github/stars/taiatiniyara/ironlox?style=social" alt="GitHub stars" class="h-5" loading="lazy" />
          </div>
        </div>
        <p class="text-xs text-surface-700">iOS &amp; Android apps coming soon &middot; 30-day risk-free trial &middot; Cancel anytime</p>
      </div>

      <!-- Product mockup -->
      <div class="max-w-3xl mx-auto mt-16 reveal">
        <div class="relative rounded-2xl border border-white/6 bg-surface-850/80 overflow-hidden shadow-2xl shadow-black/40">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/4 bg-surface-900/50">
            <div class="w-3 h-3 rounded-full bg-red-500/70" />
            <div class="w-3 h-3 rounded-full bg-yellow-500/70" />
            <div class="w-3 h-3 rounded-full bg-green-500/70" />
            <span class="ml-3 text-xs text-surface-700">Ironlox Vault</span>
          </div>
          <div class="p-6 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-white/4">
              <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">github.com</div>
                <div class="text-xs text-surface-700">john.dev@email.com</div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-[10px] font-medium">Autofill ready</span>
            </div>
            <div class="flex items-center gap-3 pb-3 border-b border-white/4">
              <div class="w-8 h-8 rounded-lg bg-surface-700/30 flex items-center justify-center">
                <svg class="w-4 h-4 text-surface-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">stripe.com</div>
                <div class="text-xs text-surface-700">admin@company.com</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-sm font-medium text-white">Visa &bull;&bull;&bull;&bull; 4242</div>
                <div class="text-xs text-surface-700">Expires 12/26</div>
              </div>
            </div>
          </div>
          <div class="px-6 py-3 bg-surface-900/80 border-t border-white/4 flex items-center justify-between">
            <span class="text-[11px] text-surface-700">12 items in vault</span>
            <div class="flex gap-2">
              <div class="w-16 h-1.5 rounded-full bg-surface-700/50"><div class="w-3/4 h-full rounded-full bg-red-500/50" /></div>
              <span class="text-[10px] text-surface-700">Health: Fair</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar -->
    <section class="border-y border-white/4 bg-surface-850/50">
      <div class="max-w-5xl mx-auto px-6 py-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          <div class="flex items-center gap-3 reveal reveal-delay-1">
            <LockIcon /> <span class="text-xs text-surface-200 font-medium">AES-256-GCM</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-2">
            <ShieldIcon /> <span class="text-xs text-surface-200 font-medium">Argon2id</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-3">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span class="text-xs text-surface-200 font-medium">Open Source</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-4">
            <EyeOffIcon /> <span class="text-xs text-surface-200 font-medium">Zero-Knowledge</span>
          </div>
          <span class="text-surface-700 hidden sm:inline">&middot;</span>
          <div class="flex items-center gap-3 reveal reveal-delay-5">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="text-xs text-surface-200 font-medium">No Trackers</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <SectionHeading title="One vault for your entire digital life" subtitle="Passwords, payments, notes, identities, files, and 2FA codes. All encrypted. All in one place." />
        <div class="grid md:grid-cols-3 gap-8">
          <FeatureCard title="End-to-End Encrypted" description="AES-256-GCM encryption locks your vault on your device. Your master password never leaves your browser. We couldn&rsquo;t read your data if we wanted to." delay={1}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </FeatureCard>
          <FeatureCard title="One-Click Autofill" description="Instantly fill usernames, passwords, credit cards, and TOTP codes on any site. Works on Chrome and Firefox. Saves you hundreds of keystrokes every day." delay={2}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </FeatureCard>
          <FeatureCard title="Smart Generator" description="Create strong, unique passwords and passphrases with customizable rules. Length, symbols, numbers &mdash; generated locally on your device. Never reused. Never weak." delay={3}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
          </FeatureCard>
          <FeatureCard title="Cross-Device Sync" description="Your vault syncs seamlessly across all your devices. Add a login on your desktop, it appears instantly on your phone. Your cards, notes, and files are always with you. Always encrypted." delay={4}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </FeatureCard>
          <FeatureCard title="Vault Health Reports" description="Scan your vault for weak, reused, and breached passwords. Get actionable recommendations. Premium feature with automatic breach monitoring." delay={5}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </FeatureCard>
          <FeatureCard title="More Than Passwords" description="Store credit cards, secure notes, identities, file attachments, and TOTP codes. One vault for all your sensitive digital life." delay={6}>
            <svg slot="icon" class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </FeatureCard>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-24 px-6 bg-surface-900/50">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How it works</h2>
          <p class="text-surface-200">Three simple steps. Zero compromises on privacy.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center relative reveal reveal-delay-1">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">1</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Create your vault</h3>
            <p class="text-sm text-surface-200">Sign up with your email and create a master password. Your encryption keys are derived and stored only on your device.</p>
          </div>
          <div class="text-center relative reveal reveal-delay-2">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">2</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Fill your vault</h3>
            <p class="text-sm text-surface-200">Save logins, credit cards, secure notes, and identities. Import from another manager or capture them as you browse. Everything is encrypted before syncing.</p>
          </div>
          <div class="text-center relative reveal reveal-delay-3">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-5">
              <span class="text-xl font-bold text-brand-400">3</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Browse with peace</h3>
            <p class="text-sm text-surface-200">Autofill logs you in with one click. Your vault syncs across all your devices. You never type another password again.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Social proof -->
    <section class="py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14 reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Built for people who care about privacy</h2>
          <p class="text-surface-200">Join thousands of developers, security engineers, and privacy-conscious individuals.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8 mb-14">
          <TestimonialCard
            quote="Finally, a password manager where I can actually read the encryption code. As a security engineer, Ironlox gives me what 1Password never could: verifiable trust."
            name="Sarah K." role="Security Engineer" initials="SK" delay={1}
          />
          <TestimonialCard
            quote="Switched from LastPass after the breaches. Ironlox is zero-knowledge done right. The import took 30 seconds and I had my 400+ passwords migrated."
            name="Marcus R." role="Full-Stack Developer" initials="MR" initialsColor="green" delay={2}
          />
          <TestimonialCard
            quote="I&rsquo;m not technical, but I needed something I could trust after my bank account got hacked. Ironlox makes security simple without being condescending. The autofill just works."
            name="Lisa P." role="Graphic Designer" initials="LP" initialsColor="purple" delay={3}
          />
        </div>
        <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 text-center">
          <div>
            <div class="text-2xl font-bold text-white">100%</div>
            <div class="text-xs text-surface-700">Client-side encrypted</div>
          </div>
          <div class="w-px h-8 bg-white/6 hidden sm:block" />
          <div>
            <div class="text-2xl font-bold text-white">0</div>
            <div class="text-xs text-surface-700">Third-party trackers</div>
          </div>
          <div class="w-px h-8 bg-white/6 hidden sm:block" />
          <div>
            <div class="text-2xl font-bold text-white">24/7</div>
            <div class="text-xs text-surface-700">Encrypted at rest &amp; in transit</div>
          </div>
          <div class="w-px h-8 bg-white/6 hidden sm:block" />
          <div>
            <div class="text-2xl font-bold text-white">1</div>
            <div class="text-xs text-surface-700">Master password to rule them all</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Security deep dive -->
    <section class="py-24 px-6 bg-surface-900/50">
      <div class="max-w-4xl mx-auto">
        <div class="rounded-2xl border border-brand-500/10 bg-linear-to-br from-brand-500/5 to-transparent p-10 md:p-16 reveal">
          <div class="flex flex-col md:flex-row items-center gap-10">
            <div class="flex-1">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300 text-xs font-medium mb-4">
                <ShieldIcon class="w-3.5 h-3.5" /> Security
              </div>
              <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">We never see your data. Ever.</h2>
              <p class="text-surface-200 leading-relaxed mb-6">
                Every byte of your vault is encrypted with AES-256-GCM on your device before it reaches our servers.
                Your master password is used to derive your encryption key using Argon2id &mdash; different salts for auth and encryption.
                Even under subpoena, we have nothing to hand over but encrypted blobs we cannot read.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3 text-sm text-surface-200">
                  <CheckIcon /> <span>Client-side encryption. Server is zero-knowledge.</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-surface-200">
                  <CheckIcon /> <span>Master password never leaves your device.</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-surface-200">
                  <CheckIcon /> <span>Every line of crypto code is open source &mdash; audit it yourself.</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-surface-200">
                  <CheckIcon /> <span>Export your data anytime &mdash; CSV, JSON, encrypted backup. No lock-in. Leave in 60 seconds.</span>
                </li>
              </ul>
            </div>
            <div class="flex-1 flex justify-center">
              <div class="relative w-64 h-64">
                <div class="absolute inset-0 rounded-full bg-brand-500/5 border border-brand-500/10" />
                <div class="absolute inset-6 rounded-full bg-brand-500/10 border border-brand-500/20" />
                <div class="absolute inset-12 rounded-full bg-brand-500/20 flex items-center justify-center">
                  <svg class="w-16 h-16 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Audit & Trust -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto text-center reveal">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-500/20 bg-brand-500/5 text-brand-300 text-sm mb-6">
          <ShieldIcon class="w-4 h-4" /> Built on trust, verified by code
        </div>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 mb-6">
          <div class="flex items-center gap-2 text-sm text-surface-200">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span>100% open source</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-surface-200">
            <LockIcon /> <span>AES-256-GCM + Argon2id</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-surface-200">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Security audit planned Q4 2025</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-surface-200">
            <svg class="w-5 h-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>GDPR &amp; CCPA ready</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section id="comparison" class="py-24 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-14 reveal">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How we compare</h2>
          <p class="text-surface-200">See why Ironlox is the better choice for your privacy.</p>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-white/6 reveal reveal-delay-1">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/6 bg-surface-850/50">
                <th class="text-left px-6 py-4 text-surface-200 font-medium">Feature</th>
                <th class="px-6 py-4 text-brand-400 font-semibold">Ironlox</th>
                <th class="px-6 py-4 text-surface-700">1Password</th>
