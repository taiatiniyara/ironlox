<script>
  requestAnimationFrame(() => {
    document.getElementById("hero-content")?.classList.add("hero-visible");
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("revealed");
      });
    },
    { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

  document.getElementById("billing-monthly")?.addEventListener("click", () => {
    document.getElementById("billing-monthly")?.classList.add("bg-brand-500", "text-white");
    document.getElementById("billing-monthly")?.classList.remove("text-surface-200");
    document.getElementById("billing-annual")?.classList.remove("bg-brand-500", "text-white");
    document.getElementById("billing-annual")?.classList.add("text-surface-200");
    document.querySelectorAll(".price-monthly").forEach(e => e.classList.remove("hidden"));
    document.querySelectorAll(".price-annual").forEach(e => e.classList.add("hidden"));
  });
  document.getElementById("billing-annual")?.addEventListener("click", () => {
    document.getElementById("billing-annual")?.classList.add("bg-brand-500", "text-white");
    document.getElementById("billing-annual")?.classList.remove("text-surface-200");
    document.getElementById("billing-monthly")?.classList.remove("bg-brand-500", "text-white");
    document.getElementById("billing-monthly")?.classList.add("text-surface-200");
    document.querySelectorAll(".price-annual").forEach(e => e.classList.remove("hidden"));
    document.querySelectorAll(".price-monthly").forEach(e => e.classList.add("hidden"));
  });
</script>
