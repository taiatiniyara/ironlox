---
import LegalPage from "../components/LegalPage.astro";
---

<LegalPage title="Migration Guides — Ironlox" canonicalURL="https://ironlox.com/migration-guides">
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-white mb-3">Migration Guides</h2>
    <p class="text-surface-200 leading-relaxed text-sm mb-3">
      Step-by-step guides for migrating your passwords from other managers.
    </p>
    <ul class="text-surface-200 mt-3 space-y-2.5 text-sm list-disc list-inside leading-relaxed">
      <li>Migrating from 1Password — export as CSV, then use the Import page.</li>
      <li>Migrating from Bitwarden — export as CSV, then use the Import page.</li>
      <li>Migrating from LastPass — export as CSV, then use the Import page.</li>
      <li>Migrating from Chrome Password Manager — export as CSV, then use the Import page.</li>
    </ul>
    <p class="text-surface-200 leading-relaxed text-sm mt-3">
      Detailed guides with screenshots coming soon.
    </p>
  </section>
</LegalPage>
