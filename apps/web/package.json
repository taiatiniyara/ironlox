    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "lucide-react": "^1.17.0",
    "i18next": "^26.3.1",
    "react-i18next": "^17.0.8",
    "fuse.js": "^7.0.0",
    "zxcvbn": "^4.4.2",
    "sonner": "^2.0.0"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.3",
