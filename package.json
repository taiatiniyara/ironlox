{
  "name": "ironlox",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge consumer password manager — monorepo root",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "graphify": "python3 -m graphify .",
    "graphify:update": "python3 -m graphify . --update",
    "graphify:watch": "python3 -m graphify . --watch",
    "graphify:query": "python3 -m graphify query",
    "graphify:explain": "python3 -m graphify explain",
    "graphify:path": "python3 -m graphify path",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,tsx}": [
      "eslint --config eslint.config.js --fix",
      "prettier --write"
    ],
    "apps/extension/src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "eslint --config eslint.config.js",
      "prettier --write"
    ]
  }
}
