{
  "name": "ironlox",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge consumer password manager — monorepo root",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironlox/ironlox.git"
  },
  "bugs": {
    "url": "https://github.com/ironlox/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "graphify": "python3 -m graphify .",
    "graphify:update": "python3 -m graphify . --update",
    "graphify:watch": "python3 -m graphify . --watch",
    "graphify:query": "python3 -m graphify query",
    "graphify:explain": "python3 -m graphify explain",
    "graphify:path": "python3 -m graphify path"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.4",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  }
}
