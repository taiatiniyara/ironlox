{
  "name": "@ironlox/api-client",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed Hono RPC client for the Ironlox API",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git",
    "directory": "packages/api-client"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": ["password-manager", "zero-knowledge", "hono", "rpc", "api-client"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ironlox/schemas": "workspace:*",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "eslint": "^10.4.1",
    "vitest": "^4.1.8",
    "typescript": "^6.0.3"
  }
}
