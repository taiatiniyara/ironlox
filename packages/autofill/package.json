{
  "name": "@ironlox/autofill",
  "version": "0.1.0",
  "type": "module",
  "description": "Form detection and credential autofill for Ironlox browser extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git",
    "directory": "packages/autofill"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": ["password-manager", "zero-knowledge", "autofill", "form-detection", "browser-extension"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "eslint": "^10.6.0",
    "vitest": "^4.1.9",
    "typescript": "^6.0.3"
  }
}
