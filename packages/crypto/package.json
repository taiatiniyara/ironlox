{
  "name": "@ironlox/crypto",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-knowledge encryption, key derivation, and TOTP for Ironlox",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git",
    "directory": "packages/crypto"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": ["password-manager", "zero-knowledge", "encryption", "aes-gcm", "argon2id", "totp", "security"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ironlox/schemas": "workspace:*",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "eslint": "^10.4.1",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3"
  }
}
