{
  "name": "@ironlox/schemas",
  "version": "0.1.0",
  "type": "module",
  "description": "Zod schemas and shared types for Ironlox",
  "repository": {
    "type": "git",
    "url": "https://github.com/taiatiniyara/ironlox.git",
    "directory": "packages/schemas"
  },
  "bugs": {
    "url": "https://github.com/taiatiniyara/ironlox/issues"
  },
  "homepage": "https://ironlox.com",
  "keywords": ["password-manager", "zero-knowledge", "zod", "validation", "schemas"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@ironlox/tsconfig": "workspace:*",
    "eslint": "^10.4.1",
    "vitest": "^4.1.8",
    "typescript": "^6.0.3"
  }
}
